# Copia este archivo a .env.local y pega los valores del proyecto Supabase.
# Rama danaipop: proyecto `grupos-blue` (ver docs/danaipop.md).
# Settings → API. Usa la URL del proyecto y la publishable key.
# No pongas aquí la service role key: esa llave no va al navegador ni al repo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para npm run auth:sin-confirmacion (Management API). No commitear.
# SUPABASE_ACCESS_TOKEN=

# Stripe, cuenta de prueba de Blue People. La secret key no lleva NEXT_PUBLIC.
# Developers → API keys, con Test mode encendido.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET=
# Solo en el servidor, para que el webhook cierre la venta si el navegador se cierra.
# SUPABASE_SERVICE_ROLE_KEY=
